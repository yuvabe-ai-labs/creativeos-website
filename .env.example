# The Apps Script web app bound to the submissions Google Sheet.
# Deploy → New deployment → Web app → Execute as: Me → Who has access: Anyone.
# Copy the /exec URL here. See docs/apps-script/submissions.gs for the script
# and the full setup walkthrough.
SHEETS_WEBHOOK_URL=

# A long random string. Must match the SECRET constant inside the Apps Script.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SHEETS_WEBHOOK_SECRET=
